{
  "name": "@natalia/portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Natalia Rodríguez Salas — built end to end with the VIU Design System (@viu/ui + @viu/design-tokens).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:concierge && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:viu": "node scripts/sync-viu.mjs",
    "check:concierge": "node --experimental-strip-types scripts/check-concierge.mjs"
  },
  "dependencies": {
    "@viu/design-tokens": "file:vendor/viu-design-tokens",
    "@viu/ui": "file:vendor/viu-ui",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
